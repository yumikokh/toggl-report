# このファイルは bash の `source` で読み込まれます。
# 空白を含む値は必ずダブルクォートで囲んでください。

# ============================================
# Toggl（必須）
# ============================================

# Toggl Track API トークン
# https://track.toggl.com/profile の「API Token」から取得
TOGGL_API_TOKEN=

# 対象ワークスペース ID / プロジェクト ID
TOGGL_WORKSPACE_ID=
TOGGL_PROJECT_ID=

# ============================================
# 出力（任意）
# ============================================

# 出力する CSV のファイル名プレフィックス（既定: toggl-report）
# 例: toggl-report-2026-08.csv
#TOGGL_OUTPUT_PREFIX="toggl-report"

# CSV の出力先ディレクトリ（既定: $HOME）
#TOGGL_OUTPUT_DIR="$HOME"

# 報告メッセージの先頭に差し込むメンション（既定: なし）
# Slack で実際にメンションさせるには <@Uxxxxxxxx> 形式のユーザー ID が必要です。
# 平文の @name はただの文字列として表示されます。
#TOGGL_REPORT_MENTIONS="<@U01ABCDEFGH> <@U02IJKLMNOP>"

# ============================================
# Slack 送信（任意 / 両方揃ったときだけ有効）
# ============================================

# Bot User OAuth Token（xoxb- で始まる）
# 必要スコープ: files:write
#SLACK_BOT_TOKEN="xoxb-..."

# 投稿先チャンネル ID（C から始まる。bot を招待しておくこと）
#SLACK_CHANNEL_ID="C0123456789"
