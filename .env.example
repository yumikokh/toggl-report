# このファイルは bash の `source` で読み込まれます。
# 空白を含む値は必ずダブルクォートで囲んでください。

# Toggl Track API トークン
# https://track.toggl.com/profile の「API Token」から取得
TOGGL_API_TOKEN=

# 対象ワークスペース ID / プロジェクト ID
TOGGL_WORKSPACE_ID=
TOGGL_PROJECT_ID=

# --- 以下は任意 ---

# 出力する CSV のファイル名プレフィックス（既定: toggl-report）
# 例: toggl-report-2026-08.csv
#TOGGL_OUTPUT_PREFIX="toggl-report"

# CSV の出力先ディレクトリ（既定: $HOME）
#TOGGL_OUTPUT_DIR="$HOME"

# 報告メッセージの先頭に差し込むメンション（既定: なし）
#TOGGL_REPORT_MENTIONS="@alice @bob"
